<Window x:Class="GameOptimizer.V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameOptimizer V2" Width="440" SizeToContent="Height"
        MinWidth="400" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="GameOptimizer" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="후보에 2개 논리 CPU · AboveNormal 적용 · 중단 시 원복"
                   Margin="0,3,0,18" Foreground="#606775" TextWrapping="Wrap" />

        <TextBlock Text="실행 중인 게임" FontWeight="SemiBold" />
        <ComboBox x:Name="GameBox" DisplayMemberPath="Label" MinHeight="34" Margin="0,6,0,16"
                  VerticalContentAlignment="Center" DropDownOpened="GameBox_DropDownOpened" />

        <Button x:Name="RunButton" Content="추적 시작" Click="Run_Click"
                MinHeight="42" Background="{StaticResource AccentBrush}"
                Foreground="White" FontWeight="SemiBold" />

        <Border Margin="0,16,0,0" Padding="12" Background="White" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="상태" Foreground="#606775" />
                <TextBlock x:Name="StatusText" Text="게임을 선택하세요" Margin="0,4,0,10"
                           TextWrapping="Wrap" />
                <TextBlock Text="CPU 후보" Foreground="#606775" />
                <TextBlock x:Name="CandidateText" Text="없음" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
