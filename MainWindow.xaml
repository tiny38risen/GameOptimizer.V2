<Window x:Class="GameOptimizer.V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameOptimizer V2"
        Width="420" Height="420"
        MinWidth="400" MinHeight="400"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="#F3F5FA">

    <Window.Resources>
        <Style x:Key="RoundActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3166F5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="999"
                                SnapsToDevicePixels="True">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ActionGlyph"
                                           Text="▶"
                                           FontSize="54"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <ContentPresenter ContentSource="Content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity"
                                        Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity"
                                        Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>

                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="Running">
                                <Setter TargetName="ActionGlyph" Property="Text" Value="◌" />
                                <Setter TargetName="ActionGlyph" Property="Foreground" Value="#303746" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="Applied">
                                <Setter TargetName="ActionGlyph" Property="Text" Value="✓" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="Error">
                                <Setter TargetName="ActionGlyph" Property="Text" Value="!" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                         Value="Recovering">
                                <Setter TargetName="ActionGlyph" Property="Text" Value="↶" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="Running">
                    <Setter Property="Background" Value="#E6B834" />
                    <Setter Property="Foreground" Value="#303746" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="Applied">
                    <Setter Property="Background" Value="#258A52" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="Error">
                    <Setter Property="Background" Value="#D94A48" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="Recovering">
                    <Setter Property="Background" Value="#697386" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox x:Name="GameBox"
                  Grid.Row="0"
                  Height="34"
                  Margin="0,0,0,8"
                  DisplayMemberPath="Label"
                  ToolTip="현재 열려 있는 창에서 CPU 적용 대상을 선택합니다."
                  DropDownOpened="GameBox_DropDownOpened"
                  VerticalContentAlignment="Center" />

        <Viewbox Grid.Row="1"
                 Stretch="Uniform"
                 Margin="0,0,0,8">
            <Button x:Name="RunButton"
                    Content="시작"
                    Tag="Idle"
                    Click="Run_Click"
                    Width="420"
                    Height="420"
                    Style="{StaticResource RoundActionButtonStyle}" />
        </Viewbox>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
                <TextBlock Text="CPU 후보"
                           DockPanel.Dock="Left"
                           Margin="0,0,8,0"
                           Foreground="#697386"
                           FontSize="12" />

                <TextBlock x:Name="CandidateText"
                           Text="없음"
                           Foreground="#303746"
                           FontSize="12"
                           TextWrapping="NoWrap" />
            </DockPanel>

            <TextBlock x:Name="StatusText"
                       Text="대기 중"
                       Margin="0,2,0,0"
                       Foreground="#303746"
                       FontSize="13"
                       TextWrapping="NoWrap" />
        </StackPanel>
    </Grid>
</Window>
